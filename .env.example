# The canonical list of every environment variable Zis has.
#
# `pnpm check:env` asserts that every name below is read somewhere in `src/` or
# `scripts/` — drift is caught rather than documented (docs/repo-and-ci.md §4).
# The names are read in `src/lib/env.ts` and nowhere else.
#
# The two deployment sets are deliberately nearly disjoint. `DATABASE_URL` is
# the only overlap, so keeping them in sync is a one-variable problem. Do not
# grant Vercel the AI keys for symmetry: the UI being unable to reach DeepSeek
# or Cloudflare at all is a security property, not an oversight.
#
#   Variable               Vercel  Actions
#   DATABASE_URL             yes     yes
#   SESSION_SECRET           yes      -
#   DEEPSEEK_API_KEY          -      yes
#   CLOUDFLARE_ACCOUNT_ID     -      yes
#   CLOUDFLARE_API_TOKEN      -      yes
#   GITHUB_PAT                -      yes
#
# Bluesky and Hacker News need no credentials, and that absence is a decision.

# Neon Postgres. The preview environment holds the `preview` branch's URL; the
# production URL is absent from preview entirely, so a misconfigured preview
# fails closed instead of writing to the corpus.
DATABASE_URL=postgresql://user:password@host.neon.tech/zis?sslmode=require

# Session signing key for the single account's passphrase login.
SESSION_SECRET=

# DeepSeek, for summarization.
DEEPSEEK_API_KEY=

# Cloudflare Workers AI, for embeddings.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Fine-grained GitHub PAT with zero permissions selected — nothing beyond the
# default public read that every fine-grained token carries.
GITHUB_PAT=
