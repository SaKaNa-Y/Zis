# Set a distinct database for each deployment environment.
DATABASE_URL=postgresql://user:password@host.neon.tech/zis?sslmode=require
# Vercel server only. Signs reader and author session cookies.
SESSION_SECRET=

# Optional, Vercel server only. Scope the token to the intended project.
# For a single root branch, its logical size accounts for project Postgres data.
# With child branches or missing provider data the project reading is unavailable.
# https://neon.com/docs/introduction/plans#storage
NEON_PROJECT_ID=
NEON_API_KEY=
