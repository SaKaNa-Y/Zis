# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js
/.next/
/out/
/build
next-env.d.ts
.vercel

# Environment — never commit secrets
.env
.env.*
!.env.example

# Test / coverage
/coverage
*.lcov

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Editors & OS
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# Drizzle
/drizzle/meta

# Agent-session scratch. `/wayfinder` and friends create throwaway git
# worktrees here; the branches they carry are the durable part, not the checkout.
.claude/worktrees/

# Prototype fetch caches. The prototypes and their findings are kept as
# primary sources; the raw HTTP bodies they cached are not.
.scratch/**/cache/
