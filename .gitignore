# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js
/.next/
/out/
/build
next-env.d.ts
.vercel

# Environment — never commit secrets
.env
.env.*
!.env.example

# TypeScript incremental build state
*.tsbuildinfo

# Test / coverage
/coverage
*.lcov

# Reproducible local Transformers.js model cache (restored by CI)
/.cache/transformers/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Editors & OS
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# Agent-session scratch. `/wayfinder` and friends create throwaway git
# worktrees here; the branches they carry are the durable part, not the checkout.
.claude/worktrees/

# Prototype fetch caches. The prototypes and their findings are kept as
# primary sources; the raw HTTP bodies they cached are not.
# The dated suffixes are #11's: measuring an ADDITION to the source roster needs
# every source to share one fetch window, so the old cache is set aside under a
# date rather than deleted. `cache*/` covers those; `cache/` alone did not.
.scratch/**/cache/
.scratch/**/cache-*/
